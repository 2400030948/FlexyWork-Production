# Core
NODE_ENV=development
MONGODB_URI=your_rotated_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
PORT=4000

# Public app URL (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:3000

# Internal API URL used by the Next.js proxy route (defaults to http://127.0.0.1:4000)
API_URL=http://127.0.0.1:4000

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Admin bootstrap (creates admin on first DB connect if user does not exist)
ADMIN_EMAIL=admin@flexywork.local
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Gmail SMTP Configuration for Email OTP Verification (required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=FLEXYWORK <no-reply@flexywork.com>

# Google Gemini API for Natural Language Shift Creation
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway
# RAZORPAY_KEY_ID is public-safe (used by the frontend Razorpay Checkout).
# RAZORPAY_KEY_SECRET must ONLY be used on the backend. Never expose to the client.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Dev only: allow manual mark-paid endpoint (disabled in production by default)
# ENABLE_MANUAL_PAYMENTS=true
